<!-- 成果市场首页 -->
<view class="container">
  <!-- Page Hero -->
  <view class="page-hero">
    <view class="page-hero__title">成果市场</view>
    <view class="page-hero__subtitle">探索校园社团的精彩成果，发现创新与灵感</view>
  </view>

  <!-- 搜索栏 -->
  <view class="search-bar">
    <text class="search-bar__icon">🔍</text>
    <input class="search-bar__input" placeholder="搜索成果名称、类型..." value="{{searchKeyword}}" bindinput="onSearchInput" confirm-type="search"/>
  </view>

  <!-- 分类筛选 -->
  <scroll-view class="filter-scroll" scroll-x enable-flex>
    <text wx:for="{{categories}}" wx:key="*this" class="filter-tag {{(filterType === '' && item === '全部') || filterType === item ? 'active' : ''}}" data-type="{{item}}" bindtap="onFilterTap">{{item}}</text>
  </scroll-view>

  <!-- 排序 + 计数 -->
  <view class="sort-tabs">
    <text wx:for="{{sortOptions}}" wx:key="key" class="sort-tab {{sortBy === item.key ? 'active' : ''}}" data-key="{{item.key}}" bindtap="onSortTap">{{item.label}}</text>
    <text style="margin-left:auto;line-height:48rpx;font-size:24rpx;color:var(--text-tertiary)">共 {{totalCount}} 个成果</text>
  </view>

  <!-- 加载中 -->
  <view wx:if="{{loading}}" class="loading-box">
    <text style="font-size:60rpx">⏳</text>
    <text class="loading-box__text">正在加载成果...</text>
  </view>

  <!-- 卡片网格 -->
  <view wx:elif="{{filteredList.length > 0}}" class="result-grid">
    <view wx:for="{{filteredList}}" wx:key="id" class="result-card" data-id="{{item.id}}" bindtap="goDetail">
      <view class="result-card__cover">
        <image wx:if="{{item.cover}}" src="{{item.cover}}" mode="aspectFill" lazy-load/>
        <view wx:else class="result-card__cover-placeholder"></view>
        <text class="result-card__type">{{item.type}}</text>
        <text wx:if="{{item.isNew}}" class="result-card__new">NEW</text>
      </view>
      <view class="result-card__body">
        <text class="result-card__title">{{item.title}}</text>
        <text class="result-card__college">{{item.college || item.community || '校园社团'}} · {{item.type}}</text>
        <view class="result-card__score-row">
          <text class="result-card__score">{{item.score || '--'}}</text>
          <text class="result-card__score-unit">分</text>
        </view>
        <view class="result-card__stats">
          <text>👍 {{item.likeCount || 0}}</text>
          <text>👁️ {{item.viewCount || 0}}</text>
          <text>💬 {{item.commentCount || 0}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view wx:else class="empty-state">
    <text class="empty-state__icon">📭</text>
    <text class="empty-state__text">暂无符合条件的成果</text>
    <text class="empty-state__hint">试试调整搜索关键词或筛选条件</text>
  </view>
</view>
