<!-- 我的孵化 -->
<view class="container">
  <view class="page-hero">
    <view class="page-hero__title">我的孵化</view>
    <view class="page-hero__subtitle">跟踪你的成果孵化进度，见证创意变为现实</view>
  </view>

  <view class="filter-scroll" style="margin-bottom:24rpx">
    <scroll-view scroll-x enable-flex>
      <text wx:for="{{statusFilters}}" wx:key="value" class="filter-tag {{filterStatus === item.value ? 'active' : ''}}" data-value="{{item.value}}" bindtap="onFilter">{{item.label}}</text>
    </scroll-view>
  </view>

  <view wx:if="{{loading}}" class="loading-box">
    <text style="font-size:60rpx">⏳</text>
    <text class="loading-box__text">加载中...</text>
  </view>

  <view wx:elif="{{filteredList.length > 0}}">
    <view wx:for="{{filteredList}}" wx:key="id" class="card">
      <view style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:12rpx">
        <text class="text-clamp-2" style="flex:1;font-size:30rpx;font-weight:600">{{item.title}}</text>
        <text class="tag" style="flex-shrink:0;margin-left:16rpx;{{item._statusStyle}}">{{item._statusText}}</text>
      </view>
      <view style="display:flex;gap:32rpx;font-size:24rpx;color:var(--text-tertiary);margin-bottom:12rpx">
        <text>{{item.type}}</text>
        <text>评分: {{item.score || '--'}} 分</text>
        <text>{{item._date}}</text>
      </view>
      <text class="text-clamp-2" style="font-size:26rpx;color:var(--text-secondary);margin-bottom:16rpx" wx:if="{{item.description}}">{{item.description}}</text>
      <!-- 进度条 -->
      <view wx:if="{{item.incubationStatus === 1 || item.reviewStatus === 1}}" style="margin-bottom:12rpx">
        <text style="font-size:22rpx;color:var(--text-tertiary)">孵化进度 {{item._progress || 60}}%</text>
        <view style="height:8rpx;background:#E5E6EB;border-radius:4rpx;margin-top:6rpx">
          <view style="height:8rpx;background:linear-gradient(90deg,#2B5AED,#4E7BF5);border-radius:4rpx;width:{{item._progress || 60}}%;transition:width 0.6s"></view>
        </view>
      </view>
      <button class="btn-outline btn-sm" data-id="{{item.id}}" bindtap="goDetail">查看详情</button>
    </view>
  </view>

  <view wx:else class="empty-state">
    <text class="empty-state__icon">🚀</text>
    <text class="empty-state__text">暂无孵化中的成果</text>
  </view>
</view>
