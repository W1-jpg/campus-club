<!-- 我的申请 -->
<view class="container">
  <view class="page-hero">
    <view class="page-hero__title">我的申请</view>
    <view class="page-hero__subtitle">管理你的资源对接申请记录</view>
  </view>

  <view class="filter-scroll" style="margin-bottom:24rpx">
    <scroll-view scroll-x enable-flex>
      <text wx:for="{{statusFilters}}" wx:key="value" class="filter-tag {{filterStatus === item.value ? 'active' : ''}}" data-value="{{item.value}}" bindtap="onFilter">{{item.label}}</text>
    </scroll-view>
  </view>

  <view wx:if="{{loading}}" class="loading-box"><text style="font-size:60rpx">⏳</text><text class="loading-box__text">加载中...</text></view>

  <view wx:elif="{{filteredList.length > 0}}">
    <view wx:for="{{filteredList}}" wx:key="id" class="card">
      <view style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:12rpx">
        <text class="text-clamp-2" style="flex:1;font-size:30rpx;font-weight:600">{{item.resourceTitle || '资源'}}</text>
        <text class="tag" style="flex-shrink:0;margin-left:16rpx;{{item._statusStyle}}">{{item._statusText}}</text>
      </view>
      <text style="font-size:24rpx;color:var(--text-tertiary);display:block;margin-bottom:8rpx">类型: {{item.resourceType || '--'}} · 提供方: {{item.resourceProvider || '--'}}</text>
      <text style="font-size:24rpx;color:var(--text-tertiary)">申请时间: {{item._date}}</text>
      <button wx:if="{{item.status === '待审核'}}" class="btn-danger btn-sm" style="width:auto;margin-top:16rpx" data-id="{{item.id}}" bindtap="cancelApplication">取消申请</button>
    </view>
  </view>

  <view wx:else class="empty-state">
    <text class="empty-state__icon">📝</text>
    <text class="empty-state__text">暂无申请记录</text>
    <button class="btn-primary btn-sm" style="margin-top:24rpx" bindtap="goResource">去浏览资源</button>
  </view>
</view>
