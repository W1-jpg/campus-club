/* ============ 成果详情 ============ */
.detail-page { background: var(--bg-card); min-height: 100vh; }

.detail-cover {
  position: relative; width: 100%; height: 500rpx; overflow: hidden; background: #E8ECF1;
}
.detail-cover image { width: 100%; height: 100%; }
.detail-cover__score {
  position: absolute; bottom: 0; right: 0;
  background: var(--color-score); color: #fff;
  padding: 16rpx 36rpx; border-radius: 20rpx 0 0 0;
  display: flex; align-items: baseline; gap: 6rpx;
}
.score-big { font-size: 52rpx; font-weight: 800; line-height: 1; }
.score-unit { font-size: 24rpx; opacity: 0.85; }

.detail-title { font-size: 36rpx; font-weight: 700; color: var(--text-primary); margin: 24rpx 0 16rpx; line-height: 1.3; }
.detail-type-row { display: flex; align-items: center; gap: 16rpx; margin-bottom: 24rpx; }
.detail-college { font-size: 26rpx; color: var(--text-tertiary); }

.score-bar {
  background: var(--color-score-bg); border-radius: var(--radius-lg);
  padding: 28rpx; display: flex; align-items: center; justify-content: space-between; margin-bottom: 24rpx;
}
.score-bar__main { display: flex; flex-direction: column; }
.score-bar__num { font-size: 56rpx; font-weight: 800; color: var(--color-score); line-height: 1; }
.score-bar__label { font-size: 24rpx; color: var(--text-secondary); margin-top: 4rpx; }
.score-bar__stars .star { font-size: 40rpx; color: #ddd; margin-left: 4rpx; }
.score-bar__stars .star.filled { color: var(--color-score); }

.meta-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16rpx; margin-bottom: 28rpx; }
.meta-cell {
  background: var(--bg-page); border-radius: var(--radius-sm);
  padding: 20rpx 24rpx; display: flex; flex-direction: column; gap: 6rpx;
}
.meta-label { font-size: 22rpx; color: var(--text-tertiary); }
.meta-value { font-size: 26rpx; color: var(--text-primary); font-weight: 500; }

.action-bar { display: flex; gap: 16rpx; margin-bottom: 32rpx; }

.tab-bar { display: flex; border-bottom: 2rpx solid var(--border-color); margin-bottom: 24rpx; }
.tab-item {
  flex: 1; text-align: center; padding: 20rpx 0; font-size: 28rpx; font-weight: 500;
  color: var(--text-tertiary); border-bottom: 4rpx solid transparent; margin-bottom: -2rpx;
}
.tab-item.active { color: var(--color-primary); border-bottom-color: var(--color-primary); }

.tab-content { padding-bottom: 40rpx; }
.info-section { margin-bottom: 28rpx; }
.info-section__title { font-size: 30rpx; font-weight: 600; color: var(--text-primary); display: block; margin-bottom: 12rpx; }
.info-section__text { font-size: 28rpx; color: var(--text-secondary); line-height: 1.8; display: block; }

.file-list { display: flex; flex-direction: column; gap: 12rpx; }
.file-item {
  display: flex; align-items: center; padding: 20rpx 24rpx;
  background: var(--bg-page); border-radius: var(--radius-sm);
}
.file-item:active { background: var(--color-primary-bg); }

.comment-input { margin-bottom: 32rpx; }
.comment-input textarea {
  width: 100%; height: 120rpx; background: var(--bg-page); border-radius: var(--radius-sm);
  padding: 20rpx; font-size: 28rpx; box-sizing: border-box;
}
.comment-list { display: flex; flex-direction: column; gap: 20rpx; }
.comment-item { display: flex; gap: 16rpx; }
.comment-item__avatar {
  width: 64rpx; height: 64rpx; border-radius: 50%;
  background: var(--color-primary); color: #fff;
  display: flex; align-items: center; justify-content: center;
  font-size: 28rpx; font-weight: 700; flex-shrink: 0;
}
.comment-item__body { flex: 1; }
.comment-item__header { display: flex; justify-content: space-between; margin-bottom: 8rpx; }
.comment-item__author { font-size: 26rpx; font-weight: 600; color: var(--text-primary); }
.comment-item__time { font-size: 22rpx; color: var(--text-tertiary); }
.comment-item__content { font-size: 28rpx; color: var(--text-secondary); line-height: 1.6; }
