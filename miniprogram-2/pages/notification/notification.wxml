<!-- 消息通知 -->
<view class="container">
  <view style="padding:24rpx 0 8rpx">
    <text style="font-size:36rpx;font-weight:700">消息通知</text>
  </view>

  <view wx:if="{{loading}}" class="loading-box"><text style="font-size:60rpx">⏳</text><text class="loading-box__text">加载中...</text></view>

  <view wx:elif="{{notices.length > 0}}">
    <view wx:for="{{notices}}" wx:key="id" class="card" data-item="{{item}}" bindtap="viewDetail">
      <view style="display:flex;justify-content:space-between;margin-bottom:8rpx">
        <text class="text-ellipsis" style="flex:1;font-size:30rpx;font-weight:600">{{item.title}}</text>
        <view wx:if="{{!item.isRead}}" style="width:14rpx;height:14rpx;border-radius:50%;background:var(--color-danger);flex-shrink:0;margin-left:12rpx;margin-top:10rpx"></view>
      </view>
      <text class="text-clamp-2" style="font-size:26rpx;color:var(--text-secondary);margin-bottom:12rpx">{{item.content}}</text>
      <text style="font-size:22rpx;color:var(--text-tertiary)">{{item._date}} · {{item._publisher}}</text>
    </view>
  </view>

  <view wx:else class="empty-state">
    <text class="empty-state__icon">🔔</text>
    <text class="empty-state__text">暂无通知</text>
  </view>
</view>

<!-- 详情弹窗 -->
<view wx:if="{{showDetail}}" class="modal-mask" bindtap="closeDetail">
  <view class="modal-card" catchtap="">
    <text style="font-size:32rpx;font-weight:700;margin-bottom:16rpx;display:block">{{currentNotice.title}}</text>
    <text style="font-size:24rpx;color:var(--text-tertiary);display:block;margin-bottom:20rpx">{{currentNotice._date}} · {{currentNotice._publisher}}</text>
    <text style="font-size:28rpx;color:var(--text-secondary);line-height:1.8">{{currentNotice.content}}</text>
    <button class="btn-outline" style="margin-top:32rpx" bindtap="closeDetail">关闭</button>
  </view>
</view>
