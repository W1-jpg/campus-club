/* form-input / form-textarea / picker-box 已在 app.wxss 全局定义 */
.form-group { margin-bottom:24rpx; }
.form-label { font-size:28rpx; font-weight:600; color:var(--text-primary); display:block; margin-bottom:12rpx; }
.upload-row { display:flex; flex-wrap:wrap; gap:16rpx; }
.upload-preview { width:160rpx; height:160rpx; border-radius:var(--radius-sm); overflow:hidden; position:relative; }
.upload-preview image { width:100%; height:100%; }
.upload-preview__remove { position:absolute; top:0; right:0; width:40rpx; height:40rpx; background:rgba(0,0,0,0.5); color:#fff; display:flex; align-items:center; justify-content:center; font-size:28rpx; border-radius:0 0 0 12rpx; }
.upload-btn { width:160rpx; height:160rpx; border-radius:var(--radius-sm); border:2rpx dashed #ccc; display:flex; align-items:center; justify-content:center; }
