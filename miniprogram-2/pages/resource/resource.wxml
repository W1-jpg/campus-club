<!-- 资源对接 -->
<view class="container">
  <view class="page-hero">
    <view class="page-hero__title">资源对接</view>
    <view class="page-hero__subtitle">发现优质资源，助力成果孵化与项目成长</view>
  </view>

  <scroll-view class="filter-scroll" scroll-x enable-flex style="margin-bottom:24rpx">
    <text wx:for="{{typeOptions}}" wx:key="value" class="filter-tag {{filterType === item.value ? 'active' : ''}}" data-value="{{item.value}}" bindtap="onFilter">{{item.emoji}} {{item.label}}</text>
  </scroll-view>

  <view wx:if="{{loading}}" class="loading-box"><text style="font-size:60rpx">⏳</text><text class="loading-box__text">加载中...</text></view>

  <view wx:elif="{{filteredList.length > 0}}">
    <view wx:for="{{filteredList}}" wx:key="id" class="card">
      <view style="display:flex;align-items:center;gap:12rpx;margin-bottom:12rpx">
        <text class="tag" style="background:{{item._typeColor}};color:#fff">{{item.type}}</text>
        <text class="text-ellipsis" style="flex:1;font-size:30rpx;font-weight:600">{{item.title}}</text>
      </view>
      <text style="font-size:24rpx;color:var(--text-tertiary);display:block;margin-bottom:8rpx">提供方: {{item.provider || '企业'}}</text>
      <text class="text-clamp-2" style="font-size:26rpx;color:var(--text-secondary);margin-bottom:16rpx" wx:if="{{item.description}}">{{item.description}}</text>
      <view style="display:flex;align-items:center;justify-content:space-between">
        <view style="display:flex;align-items:center;gap:8rpx">
          <view style="width:12rpx;height:12rpx;border-radius:50%;background:{{item.status === '进行中' ? '#52C41A' : '#FF4D4F'}}"></view>
          <text style="font-size:24rpx;color:var(--text-tertiary)">{{item.status || '进行中'}}</text>
        </view>
        <button class="btn-primary btn-sm" style="width:auto" bindtap="applyResource" data-item="{{item}}" disabled="{{item.status !== '进行中'}}">{{item.status === '进行中' ? '立即申请' : '已截止'}}</button>
      </view>
    </view>
  </view>

  <view wx:else class="empty-state">
    <text class="empty-state__icon">🤝</text>
    <text class="empty-state__text">暂无可用资源</text>
  </view>
</view>

<!-- 申请弹窗 -->
<view wx:if="{{showApply}}" class="modal-mask" bindtap="closeApply">
  <view class="modal-card" catchtap="">
    <text style="font-size:32rpx;font-weight:700;margin-bottom:24rpx;display:block">申请资源</text>
    <view style="margin-bottom:16rpx">
      <text style="font-size:26rpx;color:var(--text-secondary)">资源名称: {{currentResource.title}}</text>
    </view>
    <picker wx:if="{{qualifiedProjects.length > 0}}" mode="selector" range="{{qualifiedProjects}}" range-key="title" bindchange="onProjectChange">
      <view class="picker-box" style="margin-bottom:16rpx">{{applyForm.projectTitle || '选择关联成果'}}</view>
    </picker>
    <textarea class="form-textarea" style="height:120rpx;margin-bottom:20rpx" placeholder="申请理由（选填）" value="{{applyForm.reason}}" bindinput="onApplyInput"/>
    <view style="display:flex;gap:16rpx">
      <button class="btn-outline btn-sm" style="flex:1" bindtap="closeApply">取消</button>
      <button class="btn-primary btn-sm" style="flex:1" bindtap="submitApply" loading="{{applyLoading}}">提交申请</button>
    </view>
  </view>
</view>
