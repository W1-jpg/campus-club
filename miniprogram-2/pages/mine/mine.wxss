.mine-page { min-height:100vh; background:var(--bg-page); }
.mine-header { position:relative; padding-bottom:80rpx; }
.mine-header__bg { height:320rpx; background:linear-gradient(135deg,#1a2642 0%,#2B5AED 100%); }
.mine-header__info { display:flex; align-items:center; gap:24rpx; padding:0 40rpx; margin-top:-60rpx; }
.mine-avatar { width:120rpx; height:120rpx; border-radius:50%; background:linear-gradient(135deg,#4E7BF5,#7C5CFC); color:#fff; display:flex; align-items:center; justify-content:center; font-size:52rpx; font-weight:700; border:6rpx solid #fff; box-shadow:0 8rpx 24rpx rgba(0,0,0,0.15); flex-shrink:0; }
.mine-info { display:flex; flex-direction:column; gap:8rpx; padding-top:40rpx; }
.mine-name { font-size:36rpx; font-weight:700; color:#fff; }
.mine-role { font-size:24rpx; color:rgba(255,255,255,0.75); }

.menu-item { display:flex; align-items:center; gap:20rpx; padding:28rpx 32rpx; border-bottom:1rpx solid var(--border-color); }
.menu-item:last-child { border-bottom:none; }
.menu-item:active { background:var(--color-primary-bg); }
.menu-item__icon { font-size:36rpx; width:48rpx; text-align:center; }
.menu-item__label { flex:1; font-size:30rpx; font-weight:500; color:var(--text-primary); }
.menu-item__arrow { font-size:28rpx; color:var(--text-tertiary); }
