<!-- 个人中心 -->
<view class="mine-page safe-bottom">
  <!-- 用户头部卡片 -->
  <view class="mine-header">
    <view class="mine-header__bg"></view>
    <view class="mine-header__info">
      <view class="mine-avatar">{{avatarChar}}</view>
      <view class="mine-info">
        <text class="mine-name">{{userInfo.nickName || userInfo.username || '未登录'}}</text>
        <text class="mine-role">{{roleText}} · {{userInfo.college || '未知学院'}}</text>
      </view>
    </view>
  </view>

  <!-- 功能入口 -->
  <view class="container" style="margin-top:-40rpx;position:relative;z-index:1">
    <view class="card" style="padding:0;overflow:hidden">
      <view wx:for="{{menuList}}" wx:key="path" class="menu-item" data-path="{{item.path}}" bindtap="navigate">
        <text class="menu-item__icon">{{item.icon}}</text>
        <text class="menu-item__label">{{item.label}}</text>
        <text class="menu-item__arrow">></text>
      </view>
    </view>

    <view class="card" style="padding:0;overflow:hidden;margin-top:20rpx">
      <view class="menu-item" bindtap="goAbout">
        <text class="menu-item__icon">❓</text>
        <text class="menu-item__label">关于平台</text>
        <text class="menu-item__arrow">></text>
      </view>
    </view>

    <button class="btn-danger" style="margin-top:40rpx;width:100%" bindtap="handleLogout">退出登录</button>
  </view>
</view>
