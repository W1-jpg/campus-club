# 复制为 .env 后填写真实值；.env 已被 .gitignore 忽略，不会提交
# 生成随机密钥：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES=12h

# QQ 邮箱 SMTP（使用「授权码」，不是 QQ 登录密码）
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_account@qq.com
SMTP_PASS=your_smtp_authorization_code
MAIL_TO=your_account@qq.com
